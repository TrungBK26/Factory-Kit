# ==========================================
# Unity Standard .gitignore for GitHub
# ==========================================

# Unity generated directories (Can be thousands of files, several GBs)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset store tools
AssetStoreTools*

# Autogenerated VS/Rider/VSCode project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# OS generated
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDEs
.idea/
.vs/
.vscode/

# Scratch & temporary logs
scratch/
*.log
